# Copy to .env.local and fill in your own values

# Express API (server/) — e.g. http://localhost:7000 in development
VITE_API_URL=

# Firebase web app config (Project settings → Your apps)
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=

# Stripe publishable key (pk_test_…)
VITE_STRIPE_PUBLISHABLE_KEY=

# imgbb API key for profile photo uploads
VITE_IMGBB_API_KEY=
