# Copy to .env and fill in your own values. Never commit .env.

# MongoDB connection string (Atlas or local), and database name
MONGODB_URI=mongodb://localhost:27017
DB_NAME=ExpressLane

# Long random string used to sign session cookies
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=

# Firebase project id (same as the client's VITE_PROJECT_ID); used to verify sign-ins
FIREBASE_PROJECT_ID=

# Stripe secret key (sk_test_…). Payments return 503 when unset.
STRIPE_SECRET_KEY=

# Comma-separated list of allowed front-end origins
CLIENT_ORIGINS=http://localhost:5173

# Set to "production" when deployed (enables secure cross-site cookies)
NODE_ENV=development
PORT=7000
